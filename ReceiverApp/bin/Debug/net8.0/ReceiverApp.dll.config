<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <appSettings>
        <add key="db_host" value="localhost"/>
        <add key="db_port" value="5432"/>
        <add key="db_user" value="postgres"/>
        <add key="db_password" value="admin"/>
        <add key="db_name" value="test"/>
        
        <add key="KafkaBootstrapServers" value="localhost:9092"/>
        <add key="KafkaTopic" value="tracks"/>
        <add key="KafkaGroupId" value="receiver-group"/>
    </appSettings>
</configuration>