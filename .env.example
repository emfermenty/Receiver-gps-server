# Для лабораторной: передача каждой строки через gRPC поверх TLS.
TRANSPORT=grpc
# В одной Docker-сети:
GRPC_ADDRESS=https://mapsence:5001
# На машине экспорта при запуске на двух устройствах:
# GRPC_ADDRESS=https://192.168.100.3:5002
# Этот адрес должен присутствовать в SAN серверного сертификата.
CLIENT_CERT_PASSWORD=receiver123
POSTGRES_PASSWORD=postgres

# Только для необязательных режимов auto/queue:
KAFKA_EXTERNAL_HOST=localhost
KAFKA_BOOTSTRAP=kafka:29092
