# Скопировать в .env и заполнить на каждой машине. Без .env всё настроено на локальный запуск.

# Канал передачи, на обеих машинах одинаковый:
# auto — Kafka с переходом на сокет при сбое, queue — только Kafka, socket — только сокет
TRANSPORT=auto

# --- Машина экспорта (профиль export) ---
# Внешний адрес этой машины: по нему машина импорта подключается к Kafka (порт 9092)
KAFKA_EXTERNAL_HOST=localhost
# Адрес машины импорта: сюда ReceiverApp подключается по сокету (порт 5050)
IMPORT_HOST=mapsence

# --- Машина импорта (профиль import) ---
# Адрес Kafka на машине экспорта
KAFKA_BOOTSTRAP=kafka:29092
POSTGRES_PASSWORD=postgres

# Адреса машин должны быть и в сертификатах, выпускать их так:
#   tools/certs/generate-certs.sh 203.0.113.10 203.0.113.20
#
# Пример для двух машин: экспорт на 203.0.113.10, импорт на 203.0.113.20
#   на машине экспорта:  KAFKA_EXTERNAL_HOST=203.0.113.10
#                        IMPORT_HOST=203.0.113.20
#   на машине импорта:   KAFKA_BOOTSTRAP=203.0.113.10:9092
